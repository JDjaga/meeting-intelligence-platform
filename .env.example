# Copy this file to .env and paste your real keys there.
# .env is git-ignored (see .gitignore) so secrets never reach GitHub.

# --- LLM (Gemini only; chat tries Gemini -> HF) ---
GEMINI_API_KEY=
MIP_GEMINI_MODEL=gemini-2.0-flash
MIP_GEMINI_FALLBACK=gemini-1.5-flash
HF_TOKEN=
MIP_HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# --- Behaviour ---
# auto | gemini | hf  (chat backend preference)
MIP_CHAT_BACKEND=auto
# auto | gemini | rules        (extraction provider)
MIP_PROVIDER=auto
# confidence below this goes to human review
MIP_REVIEW_THRESHOLD=0.60

# --- Storage ---
# MIP_DB_PATH=data/meetings.db
